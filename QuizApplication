import java.util.Scanner;

public class QuizApplication {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String[] questions = {
                "Which keyword is used for inheritance in Java?",
                "Which method is the entry point of a Java program?",
                "Which data type stores true or false?",
                "Which keyword is used to create an object?",
                "Which collection can grow dynamically?"
        };

        String[][] options = {
                { "A. implements", "B. extends", "C. import", "D. package" },
                { "A. start()", "B. run()", "C. main()", "D. execute()" },
                { "A. int", "B. char", "C. boolean", "D. double" },
                { "A. class", "B. new", "C. void", "D. static" },
                { "A. ArrayList", "B. int[]", "C. String", "D. boolean" }
        };

        char[] answers = { 'B', 'C', 'C', 'B', 'A' };
        int score = 0;

        System.out.println("===== JAVA QUIZ APPLICATION =====");

        for (int i = 0; i < questions.length; i++) {
            System.out.println("\nQuestion " + (i + 1));
            System.out.println(questions[i]);

            for (String option : options[i]) {
                System.out.println(option);
            }

            char userAnswer;

            while (true) {
                System.out.print("Enter answer (A/B/C/D): ");
                String input = sc.nextLine().trim().toUpperCase();

                if (input.matches("[ABCD]")) {
                    userAnswer = input.charAt(0);
                    break;
                }

                System.out.println("Invalid input. Enter A, B, C, or D.");
            }

            if (userAnswer == answers[i]) {
                System.out.println("Correct Answer!");
                score++;
            } else {
                System.out.println("Wrong Answer!");
                System.out.println("Correct Answer: " + answers[i]);
            }
        }

        double percentage = (score * 100.0) / questions.length;

        System.out.println("\n===== FINAL RESULT =====");
        System.out.println("Total Questions: " + questions.length);
        System.out.println("Correct Answers: " + score);
        System.out.println("Wrong Answers: " + (questions.length - score));
        System.out.printf("Percentage: %.2f%%%n", percentage);

        if (percentage >= 80) {
            System.out.println("Excellent Performance!");
        } else if (percentage >= 50) {
            System.out.println("Good Job! Keep Practicing.");
        } else {
            System.out.println("Keep Learning and Try Again.");
        }

        sc.close();
    }
}
